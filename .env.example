# Hack Club Auth — https://auth.hackclub.com
# Leave these blank and /join stays on "signups opening soon".
# Do not commit real values. Orchard injects them at runtime.

# OAuth client from the HCA developer apps page.
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=

# Public origin of this site, no path. Example: https://hackcast.hackclub.com
# HCA_REDIRECT_URI defaults to ${PUBLIC_BASE_URL}/auth/callback
PUBLIC_BASE_URL=

# Optional. Set this only when it must differ from ${PUBLIC_BASE_URL}/auth/callback.
# Register the exact same string as a redirect URI on the HCA app.
HCA_REDIRECT_URI=

# Hackatime — https://hackatime.hackclub.com
# Confidential server app. Scopes: profile and read. Do not request admin.
# HACKATIME_CLIENT_ID is the app UID. PUBLIC_HACKATIME_OAUTH_UID is the same
# id under Hackatime's other name; the client id wins when both are set.
# Register both redirect URIs (one per line) on the Hackatime app:
#   https://hackcast.hackclub.com/auth/hackatime/callback
#   http://localhost:5173/auth/hackatime/callback
# Production uses ${PUBLIC_BASE_URL}/auth/hackatime/callback. Set PUBLIC_BASE_URL
# in Orchard. Leave it unset for `npm run dev` and the callback follows
# http://localhost:5173 (register that URI too).
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=
# PUBLIC_HACKATIME_OAUTH_UID=

# Long random string. Signs the httpOnly session cookie. Example: openssl rand -base64 32
SESSION_SECRET=

# Orchard Postgres 17 connection string.
DATABASE_URL=

# Comma-separated Hack Club Slack member IDs that can open /admin/rsvps
ADMIN_SLACK_IDS=
